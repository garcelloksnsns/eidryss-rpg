# Copie este arquivo para .env e altere apenas o necessário.
HOST=0.0.0.0
PORT=8000
DATA_FILE=./data/eidryss.json
VAULT_KEY_FILE=./data/server.key
SESSION_DAYS=30

# Escolha o provedor na tela da campanha. As chaves ficam só no servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
GROK_API_KEY=
GROK_MODEL=grok-4.6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Opcional: endereço compatível com a API do OpenAI/OpenRouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Opcional: outro provedor que aceite o formato OpenAI /chat/completions.
# Também pode ser configurado pelo perfil do líder, sem editar este arquivo.
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_BASE_URL=

# Apenas para ferramentas do Host em campanhas tutorial.
EIDRYSS_DEV_TOOLS=0
